{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Query availability SLI (30d)",
      "description": "Good query responses divided by valid query responses. 4xx responses are excluded from the denominator.",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{handler=\"/query\",status!~\"4..|5..\"}[30d])) / clamp_min(sum(rate(http_requests_total{handler=\"/query\",status!~\"4..\"}[30d])), 0.001)", "instant": true, "legendFormat": "availability"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.995}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Availability budget remaining",
      "description": "Remaining fraction of the 30-day 0.5% availability error budget.",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "clamp_min(clamp_max((sum(rate(http_requests_total{handler=\"/query\",status!~\"4..|5..\"}[30d])) / clamp_min(sum(rate(http_requests_total{handler=\"/query\",status!~\"4..\"}[30d])), 0.001) - 0.995) / 0.005, 1), 0)", "instant": true, "legendFormat": "budget"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.1}, {"color": "green", "value": 0.5}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Query latency p95",
      "description": "API-boundary p95 query latency over 30 days; target is 30 seconds.",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/query\"}[30d])) by (le))", "instant": true, "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 30}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Latency budget remaining",
      "description": "Remaining fraction of the 5% query-over-30s latency budget.",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "clamp_min(clamp_max((0.05 - (1 - sum(rate(http_request_duration_seconds_bucket{handler=\"/query\",le=\"30\"}[30d])) / clamp_min(sum(rate(http_request_duration_seconds_count{handler=\"/query\"}[30d])), 0.001))) / 0.05, 1), 0)", "instant": true, "legendFormat": "budget"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.1}, {"color": "green", "value": 0.5}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Ingestion completeness (30d)",
      "description": "One minus the ingestion DLQ rate divided by consumed ingestion work.",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "1 - (sum(rate(graphrag_broker_dlq_messages_total{queue=~\".*ingest.*\"}[30d])) / clamp_min(sum(rate(graphrag_broker_messages_consumed_total{queue=~\".*ingest.*\"}[30d])), 0.001))", "instant": true, "legendFormat": "completeness"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.999}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Latest RAGAS faithfulness",
      "description": "Latest finite retrieval-backed evaluation. Reference-only judge results are excluded.",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "graphrag_evaluation_faithfulness{source=\"ragas\"}", "instant": true, "legendFormat": "faithfulness"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.8}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "type": "timeseries",
      "title": "Query 5xx error rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{handler=\"/query\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{handler=\"/query\"}[5m])), 0.001)", "legendFormat": "5xx rate"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "Broker DLQ rate by queue",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (queue) (rate(graphrag_broker_dlq_messages_total[5m]))", "legendFormat": "{{queue}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "GenAI token usage rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (system, direction) (rate(graphrag_gen_ai_client_token_usage_total[5m]))", "legendFormat": "{{system}} / {{direction}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["graphrag", "slo", "error-budget"],
  "templating": {"list": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "prometheus"}, "options": [], "refresh": 1}]},
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"]},
  "timezone": "browser",
  "title": "GraphRAG SLO & Error Budget",
  "uid": "graphrag-slo",
  "version": 1
}
